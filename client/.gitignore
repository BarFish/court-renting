# ==========================================
# Frontend Gitignore - React / Vite / Node
# ==========================================

# Dependencies
node_modules/
/jspm_packages/

# Production Build Output
dist/
dist-ssr/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor/Tools Caches
.eslintcache
.stylelintcache
.vite/
.parcel-cache/